# Your BrowserPod API key, read at build time. Get one at https://browserpod.io
VITE_BP_APIKEY=

# Optional — the "Ask AI" feature. These are read by the Vite dev/preview
# server's OpenRouter proxy (see vite.config.js) and are NOT wired up on a
# static Cloudflare Pages deploy. Leave blank to disable Ask AI.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=acree-ai/acree-trinity-mini:free
OPENROUTER_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=VimAmp
